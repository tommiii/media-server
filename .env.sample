PUID='1000'
PGID='1000'
TIMEZONE='Europe/Amsterdam'
BASE_DIR=<your-base-dir>
DATA_DIR=<your-data-dir> # DATA_DIR can be the same of BASE_DIR, in my case I wanna keep the config in one ssd and all the data in another ssd

# LAN address of this server: UIs are published ONLY on this address (use 0.0.0.0 to disable the restriction)
LAN_IP=192.168.1.10
# Comma separated subnets that must reach the UIs behind the VPN (LAN, plus 100.64.0.0/10 if you use Tailscale)
LAN_SUBNETS=192.168.1.0/24

# Plex is published on every IPv4 address by default (router port forward TCP 32400 -> this server).
# PLEX_BIND_IP=0.0.0.0
# Extra addresses Plex should advertise, comma separated (Tailscale address, DDNS name...), optional:
# PLEX_CUSTOM_URLS=http://100.x.y.z:32400,https://plex.example.com:32400
# https://www.plex.tv/claim/ (valid 4 minutes: generate it right before the first `docker compose up`)
PLEX_CLAIM=

# Mullvad WireGuard (the private key goes in ${BASE_DIR}/services/gluetun/wireguard_private_key, chmod 600, NOT here)
# IPv4 address only, from the [Interface] Address line of the Mullvad config (drop the fc00:... IPv6 part)
WIREGUARD_ADDRESSES=10.64.0.2/32
VPN_COUNTRIES=Netherlands

# Homarr dashboard. Encrypts the integration credentials it stores: `openssl rand -hex 32`. Never change it afterwards.
HOMARR_SECRET_ENCRYPTION_KEY=
# Filled by you after creating the admin user in Homarr (Manage > Tools > API > Authentication > new API key);
# used by ./scripts/apply_homarr_config.py
HOMARR_API_KEY=

# Logins for the web UIs, applied by ./scripts/apply_arr_config.py (README step 6.0).
# Put values with spaces, $ or # in single quotes: ARR_PASSWORD='my pass#1'
ARR_USERNAME=
ARR_PASSWORD=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# API keys / token: all filled in by ./scripts/apply_arr_config.py (Plex token from its Preferences.xml). Leave empty.
# Used by the Homarr integrations, Recyclarr and apply_download_safety.py. Then `docker compose up -d`
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
QBITTORRENT_API_KEY=
PLEX_TOKEN=
# Cleanuparr: the key is filled in by ./scripts/apply_cleanuparr_config.py, leave it empty. Its login is ARR_USERNAME / ARR_PASSWORD,
# but it needs 8+ characters: if ARR_PASSWORD is shorter, set your own here (optional).
CLEANUPARR_API_KEY=
# CLEANUPARR_USERNAME=
# CLEANUPARR_PASSWORD=

# Options for the daily duplicate-downloads job (scripts/dedupe_downloads.py). --keep-manual: never touch torrents
# you added by hand to qBittorrent. Re-run ./scripts/cron.sh install after changing it.
# DEDUPE_ARGS=--keep-manual

# Bazarr (subtitles). Its login is ARR_USERNAME / ARR_PASSWORD unless you set these (optional):
# BAZARR_USERNAME=
# BAZARR_PASSWORD=
# Subtitle providers with a free account: each one is used only when filled in (README 6.8). Italian needs at least one.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBDL_API_KEY=
SUBSOURCE_API_KEY=

# Gluetun control server API key, for retro-dashboard (`docker run --rm qmcgaw/gluetun genkey`)
GLUETUN_API_KEY=
# Optional: Gluetun's HTTP proxy (port 8888, exits through the tunnel), off while the password is empty. retro-dashboard
# uses it to ask Mullvad which server you are on and when the account expires. Password: `openssl rand -hex 24`
# GLUETUN_PROXY_USER=dashboard
GLUETUN_PROXY_PASSWORD=
