PUID='1000'
PGID='1000'
TIMEZONE='Europe/Amsterdam'
BASE_DIR=<your-base-dir>
DATA_DIR=<your-data-dir> # DATA_DIR can be the same of BASE_DIR, in my case I wanna keep the config in one ssd and all the data in another ssd

# LAN address of this server: UIs are published ONLY on this address (use 0.0.0.0 to disable the restriction)
LAN_IP=192.168.1.10
# Comma separated subnets that must reach the UIs behind the VPN (LAN, plus 100.64.0.0/10 if you use Tailscale)
LAN_SUBNETS=192.168.1.0/24

# https://www.plex.tv/claim/ (valid 4 minutes: generate it right before the first `docker compose up`)
PLEX_CLAIM=

# Mullvad WireGuard (the private key goes in ${BASE_DIR}/services/gluetun/wireguard_private_key, chmod 600, NOT here)
# IPv4 address only, from the [Interface] Address line of the Mullvad config (drop the fc00:... IPv6 part)
WIREGUARD_ADDRESSES=10.64.0.2/32
VPN_COUNTRIES=Netherlands

# Homepage dashboard (login + widgets). AUTH_SECRET: `openssl rand -base64 32`
HOMEPAGE_AUTH_SECRET=
HOMEPAGE_AUTH_PASSWORD=
# Extra hostnames/IP:port allowed to open the dashboard (optional, defaults to LAN_IP), comma separated, no spaces
# HOMEPAGE_ALLOWED_HOSTS=192.168.1.10,server.tailnet.ts.net
# API keys / token: fill after the first start (README step 6.5). Used by Homepage widgets, Recyclarr
# and apply_download_safety.py. Then `docker compose up -d`
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
QBITTORRENT_API_KEY=
PLEX_TOKEN=
